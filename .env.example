# Public values only. Copy to .env.local; restart the dev server after edits.
EXPO_PUBLIC_APP_ENV=local
# Omit URL in local mode to use LAN/emulator detection.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api

# Public web client ID used as the audience on Android and iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS registration and reverse OAuth callback scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
PADEL_IOS_BUNDLE_IDENTIFIER=
